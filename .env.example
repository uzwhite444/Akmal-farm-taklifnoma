# ─────────────────────────────────────────────────────────────
#  Akmal Farm — Taklifnoma :: Vercel Environment Variables
# ─────────────────────────────────────────────────────────────
#  Set these in Vercel: Project → Settings → Environment Variables.
#  No key is ever exposed in the browser. Never commit real values.

# Supabase → Settings → API → Project URL
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Supabase → Settings → API Keys → Secret key (sb_secret_...) — SECRET!
# (or the legacy service_role JWT). NOT the publishable/anon key — it can't write.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_XXXXXXXXXXXXXXXX

# Telegram bot token from @BotFather — SECRET!
TELEGRAM_BOT_TOKEN=123456789:AA...

# Your admin Telegram chat_id (get it from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=000000000

# (optional) salt for hashing IPs in the anti-spam layer
IP_SALT=some-random-string

# ─────────────────────────────────────────────────────────────
#  Admin panel (/admin) — content CMS login
# ─────────────────────────────────────────────────────────────

# Admin login username
ADMIN_USERNAME=WHITE

# Admin password — NEVER store the plaintext password here or anywhere in
# the repo. Store a salted scrypt hash in the format "salt:hashHex".
# Generate it locally (never commit the output):
#   node -e "const a=require('./api/_lib/auth.js');console.log(a.hashPassword('your-password'))"
ADMIN_PASSWORD_HASH=saltHex:hashHex

# Random secret used to sign admin session cookies (HMAC-SHA256).
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=64-char-random-hex
